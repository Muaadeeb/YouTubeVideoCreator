@page "/"
@inject NavigationManager Navigation
@inject IProjectService ProjectService
@inject IToastService Toast
@inject IBusyService Busy

<div class="page-wrap">
    <h1 class="page-title">Welcome to Anime Story Creator</h1>
    <p class="page-sub">Your personal YouTube video factory for original anime / manhwa-style stories — powered by Grok Imagine.</p>

    <div class="card mt-3">
        <h2 style="color: var(--text); margin: 0 0 16px 0; font-size: 20px;">Quick Start</h2>
        <div class="row-actions">
            <button class="btn btn-primary btn-lg" @onclick="ShowNewProjectModal">✨ Create New Project</button>
            <a class="btn btn-secondary" href="/projects">📁 My Projects</a>
        </div>
    </div>
</div>

@if (_showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <h2 class="modal-title">Create New Project</h2>

            <div class="stack">
                <div>
                    <label class="label">Project Name</label>
                    <input class="input" @bind="_name" placeholder="Episode 1 - The Goblin Lord Awakens" />
                </div>
                <div>
                    <label class="label">YouTube Series Name</label>
                    <input class="input" @bind="_series" placeholder="Isekai System Chronicles" />
                </div>
                <div class="grid-2">
                    <div>
                        <label class="label">Target Video Length</label>
                        <select class="select" @bind="_length">
                            <option value="Short">YouTube Short</option>
                            <option value="5-10">5-10 minutes</option>
                            <option value="15-30">15-30 minutes</option>
                            <option value="30-60">30-60+ minutes</option>
                        </select>
                    </div>
                    <div>
                        <label class="label">Art Style</label>
                        <select class="select" @bind="_style">
                            <option value="Classic">Classic Manhwa</option>
                            <option value="Dark">Dark Anime</option>
                            <option value="Vibrant">Vibrant Comic Strip</option>
                            <option value="Mono">Monochrome Manga</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseModal" disabled="@_busy">Cancel</button>
                <button class="btn btn-primary" @onclick="CreateProject" disabled="@_busy">
                    @if (_busy) { <span class="spinner"></span> }
                    Create Project
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showModal;
    private bool _busy;
    private string _name = "";
    private string _series = "";
    private string _length = "15-30";
    private string _style = "Classic";

    private void ShowNewProjectModal()
    {
        _showModal = true;
        _name = "";
        _series = "";
    }

    private void CloseModal()
    {
        if (_busy) return;
        _showModal = false;
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Toast.Show("Please enter a Project Name.", ToastLevel.Warning);
            return;
        }

        _busy = true;
        using var busy = Busy.Show("Creating project…", "Saving to SQLite on the host.");
        try
        {
            var project = new Project
            {
                ProjectName = _name.Trim(),
                SeriesName = string.IsNullOrWhiteSpace(_series) ? "Untitled Series" : _series.Trim(),
                TargetLength = _length,
                ArtStyle = _style,
                Tone = "Dark",
                Status = ProjectStatus.Draft
            };

            await ProjectService.CreateNewProjectAsync(project);
            Toast.Show($"Project '{project.ProjectName}' created.", ToastLevel.Success);
            _showModal = false;
            Navigation.NavigateTo("/story-input");
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
